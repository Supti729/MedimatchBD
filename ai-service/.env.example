# Embedding model (chosen by evaluation/evaluate.py; see evaluation/results/report.md)
MEDIMATCH_AI_MODEL_NAME=intfloat/multilingual-e5-small
# Shared secret. Laravel sends it in the X-API-Key header. Leave empty only for local development.
MEDIMATCH_AI_API_KEY=
MEDIMATCH_AI_DEVICE=cpu
MEDIMATCH_AI_MAX_CANDIDATES=200
MEDIMATCH_AI_CACHE_SIZE=5000
